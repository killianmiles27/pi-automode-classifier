{
  "name": "pi-automode-classifier",
  "version": "0.4.0",
  "description": "Auto mode for Pi: rules, a local classifier, then a decider that checks whether you asked for the call",
  "keywords": [
    "pi-package",
    "pi-extension",
    "auto-mode",
    "guardrails",
    "permissions",
    "decision-model",
    "llama.cpp"
  ],
  "license": "MIT",
  "author": "Deepu K Sasidharan",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/killianmiles27/pi-automode-classifier.git"
  },
  "homepage": "https://github.com/killianmiles27/pi-automode-classifier#readme",
  "bugs": {
    "url": "https://github.com/killianmiles27/pi-automode-classifier/issues"
  },
  "type": "module",
  "files": [
    "index.ts",
    "context.ts",
    "rules.ts",
    "automode.ts",
    "automode-rules.json",
    "config.example.jsonc",
    "systemd",
    "lancet",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "test": "node test.mjs && node test-context.mjs",
    "bench": "node bench/run.mjs --stages classifier",
    "bench:llm": "node bench/run.mjs --stages llm --suites user-requests,bench-llm-cases",
    "bench:flow": "node bench/run.mjs --stages flow",
    "bench:context": "node bench/context/collect.ts && node bench/context/analyze.ts"
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*"
  },
  "pi": {
    "extensions": [
      "./index.ts"
    ]
  },
  "contributors": [
    "Killian Miles (context decider)"
  ]
}
